# WhatsApp Web POC Configuration

# Server Port
PORT=3000

# Chrome/Chromium path (Linux: /usr/bin/chromium-browser, macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome)
CHROME_PATH=/usr/bin/chromium-browser

# Session data folder (stores auth info after QR scan)
SESSION_DATA_PATH=.wwebjs_auth

# Jira Configuration
JIRA_DOMAIN=evitar-team-gzgge6s5.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=KAN

# OpenAI Configuration (for #ask command)
OPENAI_API_KEY=your-openai-api-key
